# ============================================================
# Nazaha Employment Platform — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ── PostgreSQL (must match docker-compose.yml) ───────────────
POSTGRES_USER=nazaha
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=nazaha_db
# Host port the container is published on. NOTE: if another local service already
# uses 5432 (common on shared dev machines), set this to a free port — e.g. 5435 —
# and update the port in ALL connection strings below to match.
POSTGRES_PORT=5432

# ── Prisma connection strings ────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
#
# IMPORTANT: prisma/schema.prisma reads NEON_DATABASE_URL / NEON_DATABASE_URL_UNPOOLED
# (the datasource `url` and `directUrl`). The DATABASE_URL / DIRECT_DATABASE_URL names
# below are kept for the CI scripts (scripts/ci/test.sh, scripts/db/set-app-role-password.sh)
# and are normally set to the SAME values.
#
# Runtime connection — non-superuser role subject to Row-Level Security.
NEON_DATABASE_URL="postgresql://nazaha_app:change_me_app_password@localhost:5432/nazaha_db?schema=public"
# Migrations only — table owner (never used by the running app).
NEON_DATABASE_URL_UNPOOLED="postgresql://nazaha:change_me_strong_password@localhost:5432/nazaha_db?schema=public"
# Aliases used by the CI / db helper scripts (keep in sync with the two above).
DATABASE_URL="postgresql://nazaha_app:change_me_app_password@localhost:5432/nazaha_db?schema=public"
DIRECT_DATABASE_URL="postgresql://nazaha:change_me_strong_password@localhost:5432/nazaha_db?schema=public"
# Set on the nazaha_app role via scripts/db/set-app-role-password.sh
APP_DB_PASSWORD="change_me_app_password"
#
# Managed PostgreSQL (Supabase) + stateless host (Vercel):
#   NEON_DATABASE_URL            → Supavisor TRANSACTION pooler (port 6543), user "nazaha_app.<project-ref>",
#                                   with "?pgbouncer=true&connection_limit=1" (serverless-safe)
#   NEON_DATABASE_URL_UNPOOLED   → direct connection (port 5432) as the table owner, migrations only
#   Migration 20260913030000_managed_host_hardening strips the Data-API roles
#   (anon/authenticated/service_role) so the public anon key can never read tenant rows.

# ── Next.js ──────────────────────────────────────────────────
# In production, set these to your actual domain.
NEXTAUTH_URL="http://localhost:3002"
# Optional public base URL used to build candidate invitation links when
# NEXTAUTH_URL is not set (src/infrastructure/services/invitation.service.ts).
NEXT_PUBLIC_APP_URL="http://localhost:3002"

# Secret for signing sessions/tokens (generate with: openssl rand -base64 32)
AUTH_SECRET=change_me_generate_with_openssl

# Key for AES-256-GCM encryption of secrets at rest (SMTP passwords, InboxKit API
# keys, candidate invitation tokens). MUST be exactly 64 hex characters
# (= 32 bytes). Generate with: openssl rand -hex 32
# The app refuses to run in production if this is left at its dev default.
ENCRYPTION_KEY=change_me_generate_with_openssl_rand_-hex_32

# ── File Storage (local by default — path relative to project root) ──
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
# STORAGE_PROVIDER options:
#   local     — files on disk under STORAGE_LOCAL_PATH (development, single server)
#   database  — file bytes in PostgreSQL (stored_files); REQUIRED on stateless hosts
#               such as Vercel where the filesystem does not persist between requests
# Future: swap to s3/minio by changing STORAGE_PROVIDER and adding:
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_BUCKET=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=

# ── Email / notifications ────────────────────────────────────
# NOTIFICATION_PROVIDER selects the org-agnostic notifier used by src/infrastructure/notifications/index.ts
#   console — magic links / emails are logged to the console (default in dev)
#   smtp    — send via the SMTP_* variables below
NOTIFICATION_PROVIDER=console
# Legacy alias kept for documentation only; the code reads NOTIFICATION_PROVIDER.
EMAIL_PROVIDER=console
# Used only when NOTIFICATION_PROVIDER=smtp and an org has no per-tenant SMTP settings.
# Per-tenant SMTP credentials are configured in the app and stored encrypted in the DB.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="نزاهة التوظيف <no-reply@nazaha.gov.sa>"

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
APP_URL="http://localhost:3002"

# Magic link expiry in minutes
MAGIC_LINK_EXPIRES_MINUTES=60

# ── Development seed only ────────────────────────────────────
# These values are ONLY used by `prisma/seed.ts` in local development.
# DO NOT set these in production — production data should never come from seed.
SEED_DEV_HR_PASSWORD=
SEED_DEV_CANDIDATE_TOKEN=

# Platform admin (dev seed only — never use these values in production)
SEED_DEV_PLATFORM_EMAIL="platform@example.com"
SEED_DEV_PLATFORM_PASSWORD=

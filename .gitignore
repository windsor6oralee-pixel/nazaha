# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — only .env.example should be committed
.env
.env.local
.env.production

# local test-credentials reference — must never be committed
TEST_ACCOUNTS.md

# accepted-candidate credential sheet — passwords and the decryption key
accepted.csv
accepted.csv.enc
accepted.csv.original
accepted-name-review.csv
accepted-cleanup-log.txt
.accepted-passphrase

# playwright
/.playwright/
/test-results/
/playwright-report/

# screenshots written by the e2e walkthroughs
/screenshots/

# File storage (local uploads)
/storage/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*
